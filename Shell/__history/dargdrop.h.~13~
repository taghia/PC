typedef void __fastcall(__closure * TOnDragDropEvent)(void*Sender,
	IDataObject * pDataObject, DWORD keyState, POINTL point, DWORD * effect);
typedef void __fastcall(__closure * TOnDragLeaveEvent)(void*Sender);

class TDropTarget : public IDropTarget {
public:
	TDropTarget(HWND hwnd);
	~TDropTarget();

	TOnDragDropEvent OnDragEnter;
	TOnDragDropEvent OnDragOver;
	TOnDragDropEvent OnDragDrop;
	TOnDragLeaveEvent OnDragLeave;

	__property TStringList *Files = {
		read = GetFiles
	};

private:
	// internal helper function
	DWORD DropEffect(DWORD keyState, POINTL point, DWORD dwAllowed);
	bool QueryDataObject(IDataObject *pDataObject);
	HRESULT __stdcall DragEnter(IDataObject * pDataObject, DWORD keyState,
		POINTL point, DWORD *effect);
	HRESULT __stdcall DragOver(DWORD keyState, POINTL point, DWORD *effect);
	HRESULT __stdcall DragLeave(void);
	HRESULT __stdcall Drop(IDataObject *pDataObject, DWORD keyState,
		POINTL point, DWORD *effect);

	// IUnknown implementation
	HRESULT __stdcall QueryInterface(REFIID iid, void ** ppvObject);
	ULONG __stdcall AddRef(void);
	ULONG __stdcall Release(void);

	// Private member variables
	LONG m_lRefCount;
	HWND m_hWnd;
	bool m_fAllowDrop;

	IDataObject *m_pDataObject;
	TStringList *m_Files;

	TStringList *GetFiles();
};

