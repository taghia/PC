void __fastcall TShellChangeThread::Execute(void)
{
	DWORD numBytes;
	DWORD CompletionKey;
	LPOVERLAPPED POverlapped;
	HANDLE TempDirectoryHandle;
	HANDLE TempCompletionPort;
	while(!Terminated)
	{
		Lock();
		TempDirectoryHandle = FDirectoryHandle;
		TempCompletionPort = FCompletionPort;
		Unlock();
		if(TempDirectoryHandle > 0)
		{
			POverlapped = &FOverlapped;
			memset(FNotificationBuffer, sizeof(FNotificationBuffer), 0);
			GetQueuedCompletionStatus(TempCompletionPort, &numBytes, &CompletionKey,
				&POverlapped, INFINITE);
			if(CompletionKey == Handle) {
			Synchronize(DoIOCompletionEvent);
			FBytesWritten = 0;
			memset(FNotificationBuffer, sizeof(FNotificationBuffer), 0);
			ReadDirectoryChangesW(FDirectoryHandle, FNotificationBuffer,
				sizeof(FNotificationBuffer), FWatchSubTree, FNotifyOptionFlags,
				(PDWORD)&FBytesWritten, &FOverlapped, NULL);
			}
		}
	}
	PostQueuedCompletionStatus(TempCompletionPort, 0, 0, NULL);
}

