void __fastcall TFileView::SetDirectory(String value)
{
//	if (!DirectoryExists(value))
//		return;
	TFolderState *state = folderStates.States[Directory];
	state->offsetY = OffsetY;
	state->sortColumn = Header->SortColumn;
	state->sortDir = Header->SortDirection == sdAscending ? +1 : -1;
	int itemIndex = 0;
	String name = ExtractFileName(ExcludeTrailingBackslash(Directory));
	if (FocusedNode && RootNodeCount)
	{
		state->name = objectOf(FocusedNode)->FileName;
		itemIndex = FocusedNode->Index;
	}
	String newDir = IncludeTrailingBackslash(value);
	bool isNewDir = CompareText(newDir, FDirectory);
	FDirectory = newDir;
	history.addItem(newDir);
	EnumFiles();
	state = folderStates.States[Directory];
	Header->SortColumn = state->sortColumn;
	Header->SortDirection = state->sortDir == 1 ? sdAscending : sdDescending;
	SortParams.SortColumn = state->sortColumn;
	for (int ci=0; ci<Header->Columns->Count; ci++) {
		if(ci != Header->SortColumn)
			Header->Columns->Items[ci]->Color = clWhite;
		else
			Header->Columns->Items[ci]->Color = sortColor;
	}
	SortParams.SortDirection = state->sortDir;
	Files->sort(SortParams);
	RootNodeCount = 0;
	RootNodeCount = Files->count;
	if(state->name=="" && name != "") {
		state->name = name;
	}
	FocusedNode = getNodeByFileName(state->name);
	if(!FocusedNode) {
		if(isNewDir) {
			FocusedNode = getNode(0);
			if(FocusedNode) AddToSelection(FocusedNode);
		}
		else {
			if(itemIndex >= Files->count) itemIndex = Files->count - 1;
			FocusedNode = getNode(itemIndex);
		}
	}
	else if(isNewDir)
	{
		AddToSelection(FocusedNode);
	}
	OffsetY = state->offsetY;

	if(isNewDir)
	{
		if(DirMon)
		{
			DirMon->Actived = false;
			DirMon->WatchedDir = Directory;
			DirMon->Actived = true;
        }
		if(onDirChange) onDirChange(this);
	}
	hotObjects.clean();
}

