void TFileView::selectByType() {
	String ext = FileObject->GetExt().LowerCase();
	TVirtualNode *node;
	TFileObject *obj;
	for (int i = 0; i < (int)RootNodeCount; i++) {
		if (i == 0)
			node = GetFirst(0);
		else
			node = GetNext(node, 0);
		obj = objectOf(node);

		if (obj->GetExt().LowerCase() == ext)
			AddToSelection(node);
		else
			node->States >> vsSelected;
	}
	Repaint();
}

