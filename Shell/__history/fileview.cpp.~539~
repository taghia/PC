void TFileView::reload()
{
	TUpdateLock updateLock(this);
	if(!DirectoryExists(Directory)) {
		up();
		return;
	}
	int offset = OffsetY;
	TStringList *selected = new TStringList;
	GetSelectList(selected, false);
	TVirtualNode *beforeSelect = NULL, *first = NULL;
	bool isPrevNode = false;
	first = GetFirstSelected();
	if (first)
	{
		if(first->Index > 0)
		{
			beforeSelect = GetPrevious(first);
			isPrevNode = true;
		}
		else
			beforeSelect = first;
	}
	else
		beforeSelect = FocusedNode;

//	TFolderState *state = folderStates.States[Directory];
	EnumFiles();
	SortParams.SortColumn = Header->SortColumn;
	SortParams.SortDirection = Header->SortDirection == sdAscending ? +1 : -1;
	Files->sort(SortParams);
	//FocusedNode = NULL;
	RootNodeCount = Files->count;
	if(beforeSelect && Files->count - 1 < (int)beforeSelect->Index) beforeSelect = NULL;
	invalidateAll();

	//OffsetY = state->offsetY;
	hotObjects.clean();

	TVirtualNode *node = GetFirst();
	while(node)
	{
		TFileObject *obj = objectOf(node);
		if(!obj) ShowMessage("!obj");
		if(selected->IndexOf(obj->FileName) > -1)
		{
			AddToSelection(node);
			//if(!FocusedNode)
				FocusedNode = node;
		}
		else
			node->States >> vsSelected;
		node = GetNext(node);
	}
	if(!GetFirstSelected() && first) {
		TVirtualNode *active = NULL;
		if(beforeSelect)
		{
			if(isPrevNode)
				active = GetNext(beforeSelect);
			else
				active = beforeSelect;
			if(!active) active = beforeSelect;
		}
		else
			active = GetFirst();
		if(active)
		{
			AddToSelection(active);
			FocusedNode = active;
		}
	}
	OffsetY = offset;
}
