void __fastcall TFileView::KeyPress(wchar_t &Key) {
	if (Key == '\r')
		if (FileObject->IsDirectory()) {
			if (FileObject->IsDot())
				up();
			else
				Directory = Directory + FileName;
		}
		else
			Execute();
	TVirtualStringTree::KeyPress(Key);
}

