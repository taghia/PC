TDateTime TFileObject::GetVclDateTime(TDateKind type) {
	wchar_t date[50];
	SYSTEMTIME systime;
	FILETIME file_time, localtime;
	switch(type) {
	case dkModified:
		file_time = ftLastWriteTime;
		break;
	case dkCreated:
		file_time = ftCreationTime;
		break;
	case dkAccessed:
		file_time = ftLastAccessTime;
		break;
	}
	FileTimeToLocalFileTime(&file_time, &localtime);
	FileTimeToSystemTime(&localtime, &systime);
	return SystemTimeToDateTime(systime);
}

String TFileObject::GetDate(TDateKind type) {
	wchar_t date[50];
	SYSTEMTIME systime;
	FILETIME file_time, localtime;
	switch(type) {
	case dkModified:
		file_time = ftLastWriteTime;
		break;
	case dkCreated:
		file_time = ftCreationTime;
		break;
	case dkAccessed:
		file_time = ftLastAccessTime;
		break;
	}

	FileTimeToLocalFileTime(&file_time, &localtime);
	FileTimeToSystemTime(&localtime, &systime);
	wsprintfW(date, L"%.4i/%.2i/%.2i", systime.wYear, systime.wMonth,
		systime.wDay);

	return String(date);
}

