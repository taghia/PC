TNamespaceArray TFileView::CreateNamespaceArray(TStringList *files)
{
	FreeNamespaceArray();
	if (!files) {
		TFileObjectArray *selected = GetSelectedObjects();
		m_NamespaceArray.Length = selected->count;
		for (int t = 0; t < selected->count; t++)
		{
			String path;
			if(selected->items[t]->Path.IsEmpty())
				path = Directory;
			else
				path = selected->items[t]->Path;
			m_NamespaceArray[t] = new TNamespace
				(path + selected->items[t]->FileName);
		}
		if (!selected->count) {
			m_NamespaceArray.Length = 1;
			m_NamespaceArray[0] = new TNamespace(Directory);
		}
		delete selected;
	}
	else {
		m_NamespaceArray.Length = files->Count;
		for (int i = 0; i < files->Count; i++) {
			m_NamespaceArray[i] = new TNamespace(files->Strings[i]);
		}
	}
	return m_NamespaceArray;
}
