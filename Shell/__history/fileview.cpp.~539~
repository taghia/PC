	rightDrag |= Shift.Contains(ssRight);
	//if(!rightDrag) Beep(500, 50);
	Effect = DROPEFFECT_COPY;
	FORMATETC fmtetc = {CF_HDROP, 0, DVASPECT_CONTENT, -1, ::TYMED_HGLOBAL};
