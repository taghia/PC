//---------------------------------------------------------------------------
void TFileView::search(TSearchParams *params, String path)
{
	if(bStopSearch) return;
	HANDLE hfind = 0;
	bool result;
	TFileObject *item = Files->add();
	hfind = FindFirstFileW((IncludeTrailingBackslash(path) + (WideString)"*.*").w_str(), item);
	if (hfind == INVALID_HANDLE_VALUE) {
		Files->remove(item);
		return;
	}
	if (item->IsDot())
		Files->remove(item);
	do {
		item = Files->add();
		result = FindNextFileW(hfind, item);
		item->Path = IncludeTrailingBackslash(path);
		if (!result || item->IsDot() || !itemFound(item, params))
			Files->remove(item);
		if(item->IsDirectory())
		{
			String newDir = IncludeTrailingBackslash(path + item->FileName);
			if(onSearchNewDir) onSearchNewDir(this, newDir);
			search(params, newDir);
		}
	}
	while (result && !bStopSearch);
	FindClose(hfind);
}
//---------------------------------------------------------------------------
int fileSearch(String fileName, BYTE *buff, int len)
{
	TMemoryStream *ms = new TMemoryStream;
	try {
		ms->LoadFromFile(fileName);
		BYTE *pMem = (BYTE*)ms->Memory;
		bool compare;
		for (int i=0; i<ms->Size - len; i++) {
			compare = true;
			for (int j=0; j<len; j++) {
				compare &= tolower(buff[j]) == tolower(pMem[i + j]);
			}
			if(compare) {
				delete ms;
				return i;
			}
		}
	} catch (...) {
	}

	delete ms;
	return -1;
}
//---------------------------------------------------------------------------
bool TFileView::itemFound(TFileObject *obj, TSearchParams *params)
{
	Application->ProcessMessages();
	text fileName = obj->FileName.LowerCase();
	TSearchParam *param;
	bool result = true;
	for (int pi=0; pi<params->count; pi++) {
		param = params->items[pi];
		if(param->type & ptText)
		{
			if(param->text.contains("*"))
				result &= fileName.wciCompare(param->text);
			else
				result &= fileName.contains(param->text);
		}
		if(!result) break;
		if(param->type & ptSize)
		{
			result &= ((obj->Size <= param->sizeMax || param->sizeMax == -1) &&
				(obj->Size >= param->sizeMin || param->sizeMin == -1));
		}
		if(!result) break;
		if(param->type & ptDate)
		{
			TDateTime dt = obj->GetVclDateTime(dkModified);
			result &= ((dt <= param->dateMax || param->dateMax.Val == -1) &&
				(dt >= param->dateMin || param->dateMin.Val == -1));
		}
		if(!result) break;
		if(param->type & ptContent)
		{
			if(obj->IsDirectory())
				result = false;
			else {
				//char *str = new char[param->content.length() + 1];
				int index = fileSearch(obj->Path + obj->FileName, (char*)param->content.t_str(), param->content.length());
				//delete [] str;
				result &= (index != -1);
			}
		}
		if(!result) break;
		if((param->type & ptBuffer) && !obj->IsDirectory())
		{
			int index = fileSearch(obj->Path + obj->FileName, param->buffer, param->bufferLen);
			result &= (index != -1);
		}
	}
	end:
	if(result)
	{
		if(onItemFound) onItemFound(this);
		RootNodeCount = RootNodeCount + 1;
	}
	return result;
}
