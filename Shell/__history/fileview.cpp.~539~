// ---------------------------------------------------------------------------
String TFileObject::GetDateTime(TDateKind type, bool shamsi) {
	wchar_t date[50];
	SYSTEMTIME systime;
	FILETIME file_time, localtime;
	switch(type) {
	case dkModified:
		file_time = ftLastWriteTime;
		break;
	case dkCreated:
		file_time = ftCreationTime;
		break;
	case dkAccessed:
		file_time = ftLastAccessTime;
		break;
	}

	FileTimeToLocalFileTime(&file_time, &localtime);
	FileTimeToSystemTime(&localtime, &systime);

	int y, m, d;
	SYSTEMTIME now;
	//GetSystemTime(&now);
	GetLocalTime(&now);
	if(systime.wYear == now.wYear && systime.wMonth == now.wMonth && systime.wDay > now.wDay - 2 && systime.wDay <= now.wDay)
	{
		if(systime.wDay == now.wDay)
			wsprintfW(date, L"Today %.2i:%.2i", systime.wHour, systime.wMinute);
		else if(systime.wDay == now.wDay - 1)
			wsprintfW(date, L"Yesterday %.2i:%.2i", systime.wHour, systime.wMinute);
	}
	else
	{
		if(shamsi)
		{
			TShamsiDate date(GetVclDateTime(type));
			y = date.ShamsiYear - 1300;
			d = date.ShamsiDay;
			m = date.ShamsiMonth;
		}
		else
		{
			y = systime.wYear;
			m = systime.wMonth;
			d = systime.wDay;
		}
		wsprintfW(date, L"%i/%.2i/%.2i %.2i:%.2i", y, m, d, systime.wHour, systime.wMinute);
	}

	return String(date);
}

// ---------------------------------------------------------------------------
int CompareProc(void *i1, void *i2, TSortParams &params) {
	TFileObject *item1 = (TFileObject*)i1;
	TFileObject *item2 = (TFileObject*)i2;
	int result = item2->IsDoubleDot() - item1->IsDoubleDot();
	if (result)
		return result;

	result = item2->IsDirectory() - item1->IsDirectory();
	if (result && (params.SortColumn == colSize || params.SortColumn == colType))
		return -result;
	if (result && params.SortColumn != colDateModified && params.SortColumn !=
		colDateCreated)
		return result * params.SortDirection;
	if (params.SortColumn == colName)
		result = WideCompareText(item1->FileName, item2->FileName) * params.SortDirection;
	else if (params.SortColumn == colSize) {
		result = item1->Size - item2->Size;
		if (result)
			return result * params.SortDirection;
		result = WideCompareText(item1->FileName, item2->FileName);
	}
	else if (params.SortColumn == colType) {
		result = WideCompareText(item1->Ext, item2->Ext);
		if (result)
			return result * params.SortDirection;
		result = WideCompareText(item1->FileName, item2->FileName);
	}
	else if (params.SortColumn == colDateModified) {
		result = item1->GetVclDateTime(dkModified).Val * 1000 - item2->GetVclDateTime(dkModified).Val * 1000;
		if (result)
			return result * params.SortDirection;
		result = WideCompareText(item1->FileName, item2->FileName);
	}
	else if (params.SortColumn == colDateCreated) {
		result = item1->GetVclDateTime(dkCreated).Val * 1000 - item2->GetVclDateTime(dkCreated).Val * 1000;
		if (result)
			return result * params.SortDirection;
		result = WideCompareText(item1->FileName, item2->FileName);
	}
	else if (params.SortColumn == colAttribute) {
		result = WideCompareText(item1->Attribute, item2->Attribute);
		if (result)
			return result * params.SortDirection;
		result = WideCompareText(item1->FileName, item2->FileName);
	}
	return result;
}

TFolderState* TFolderStates::GetState(String dir) {
	dir = ExcludeTrailingBackslash(dir);
	for (int i = 0; i < m_States->count; i++) {
		if (!WideCompareText(m_States->items[i]->dir, dir))
			return m_States->items[i];
	}
	TFolderState* state = m_States->add();
	state->dir = dir;
	return state;
}

// ---------------------------------------------------------------------------
void TFolderStates::SetState(String dir, TFolderState* value) {
	TFolderState* state = GetState(dir);
	if (!state) {
		state = m_States->add();
		state->dir = dir;
	}
	state->offsetY = value->offsetY;
	state->name = value->name;
	state->sortColumn = value->sortColumn;
	state->sortDir = value->sortDir;
}

