// ----------------------------------------------------------------------------------------
void TFileView::remark() {
	String newName;
	TFileObjectArray *selected = GetSelectedObjects();

	lockUpdate = true;

	for (int t = 0; t < selected->count; t++) {
		String ext = selected->items[t]->Ext;
		if (!CompareText(ext, ".rem"))
			newName = Directory + ChangeFileExt(selected->items[t]->FileName,
			"");
		else
			newName = Directory + selected->items[t]->FileName + ".rem";
		while (FileExists(Directory + newName))
			newName += ".rem";
		RenameFile(Directory + selected->items[t]->FileName, newName);
	}
	delete selected;
	lockUpdate = false;
}

