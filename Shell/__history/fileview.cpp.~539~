//---------------------------------------------------------------------------
void TFileView::copy(TStringList *Src, String Des, HWND parent)
{
	lockUpdate = true;
	wchar_t *src;
	int size = 0;

	for(int t=0;t<Src->Count;t++)
		size += Src->Strings[t].Length() * 2 + 2;

	src = (wchar_t*)malloc(size + 4);

	ZeroMemory(src, size);

	int Lens = 0;
	for(int t=0;t<Src->Count;t++)
	{
		wcscat(src, Src->Strings[t].w_str());
		Lens += Src->Strings[t].Length();
		src[Lens] = '<';
		Lens += 1;
		src[Lens] = NULL;
	}
	int l = wcslen(src);
	for(int t=0;t<l;t++)
	{
		if(src[t] == (wchar_t)'<')
			src[t] = 0;
	}

	SHFILEOPSTRUCTW FileOp;
	ZeroMemory( &FileOp, sizeof(SHFILEOPSTRUCTW));

	FileOp.hwnd = parent;
	FileOp.pFrom = src;
	FileOp.pTo = Des.w_str();
	FileOp.wFunc = FO_COPY;
	FileOp.fFlags = FOF_NOCONFIRMMKDIR;
	ForceDirectories(Des);
	SHFileOperationW(&FileOp);
	free(src);
	lockUpdate = false;
}
