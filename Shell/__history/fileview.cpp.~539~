//---------------------------------------------------------------------------
bool TFileView::IsNewObject(TFileObject* object)
{
	SYSTEMTIME curtime;
	GetSystemTime(&curtime);
	__int64 systime = SysTimeAsSeconds(curtime);
	__int64 t1 = GetFileDateAsSeconds(object->ftCreationTime);
	__int64 t2 = GetFileDateAsSeconds(object->ftLastWriteTime);
	//__int64 t3 = GetFileDateAsSeconds(object->ftLastAccessTime);
	return systime - t1 < 3600 || systime - t2 < 3600;
}
//---------------------------------------------------------------------------
__int64 TFileView::SysTimeAsSeconds(SYSTEMTIME systime)
{
	return
		systime.wYear * 12 * 31 * 24 * 60 * 60 +
		systime.wMonth * 31 * 24 * 60 * 60 +
		systime.wDay * 24 * 60 * 60 +
		systime.wHour * 60 * 60 +
		systime.wMinute * 60 +
		systime.wSecond;
}
//---------------------------------------------------------------------------
__int64 TFileView::GetFileDateAsSeconds(FILETIME &filetime)
{
	SYSTEMTIME systime;// = FileTimeToSysTime(filetime);
	FileTimeToSystemTime(&filetime, &systime);
	return SysTimeAsSeconds(systime);
}
