// ---------------------------------------------------------------------------
void TFileView::ApplyNotifications()
{
	if(lockUpdate || searchMode) return;
	THotObject *obj;
	int index;
	TFileObject fo;
	int notify = Notifications->count;
	for (int i=0; i<Notifications->count; i++) {
		TNotification *item = Notifications->items[i];
		switch (item->action)
		{
			case foAdded:
				obj = hotObjects.add();
				obj->id = getFileID(item->fileName1);
				obj->modifyType = mtNew;
				break;
			case foRemoved:
				break;
			case foModified:
				while(i + 1 < Notifications->count
					&& Notifications->items[i + 1]->action == foModified
					&& Notifications->items[i + 1]->fileName1 == Notifications->items[i]->fileName1)
					i++;
				item = Notifications->items[i];
				index = Files->indexOf(ExtractFileName(item->fileName1));
				if(index != -1)
				{
					obj = hotObjects.add();
					obj->id = getFileID(item->fileName1);
					GetFileInfo(item->fileName1, &fo);
					obj->modifyType = DetectModifyType(Files->items[index], &fo);
					if(obj->modifyType == mtNone) {
						hotObjects.remove(obj);
						notify--;
					}
				}
				break;
			case foRenamed:
				obj = hotObjects.add();
				obj->id = getFileID(item->fileName2);
				obj->modifyType = mtModifyName;
				break;
		}
	}
	Notifications->clear();
	if(notify)
	{
		//Beep(1000, 39);
		reload();
		if(onNotify) onNotify(this);
	}
}
