void __fastcall TFileView::KeyDown(WORD &Key, TShiftState Shift) {
	if (Key == 16)
		return;

	if (Shift.Contains(ssCtrl)) {
		if (Shift.Contains(ssAlt)) {
			switch(Key) {
			case 'T':
				selectByType();
				break;
			}
		}
		else
			switch(Key) {
			case 'A':
				selectAll();
				Key = 0;
				break;

			case 'C':
			case VK_INSERT:
				RootNamespace->Copy(NamespaceArray);
				break;

			case 'X':
				RootNamespace->Cut(NamespaceArray);
				break;

			case 'V':
				paste();
				break;

			case VK_DOWN:
				// MoveCursor(Key);
				break;

			case VK_UP:
				// MoveCursor(Key);
				break;
			//case VK_F5:
				//reload();
			}
	}
	else if (Shift.Contains(ssShift)) {
		switch(Key) {
		case VK_DELETE:
			deleteSelected();
			break;

		case VK_INSERT:
			paste();
			break;

		case 'R':
			remark();
			break;
		}
	}
	else if (Shift.Contains(ssAlt)) {
		switch(Key) {
		case VK_DOWN:
			// MoveCursor(VK_DOWN + VK_MENU);
			break;

		case VK_UP:
			// MoveCursor(VK_UP + VK_MENU);
			break;

		case VK_LEFT:
			// Backward();
			break;

		case VK_RIGHT:
			// Forward();
			break;
		}
	}
	else if (Key == VK_DELETE)
	{
		deleteSelected();
//		lockUpdate = true;
//		RootNamespace->Delete(NamespaceArray);
//		Notifications->clear();
//		reload();
//		lockUpdate = false;
	}
	else if (Key == VK_F2 && FocusedNode) {
		EditNode(FocusedNode, 0);
	}
	else if (Key == VK_ESCAPE) {
		// DeSelectAll();
		UnselectNodes(GetFirst(), GetLast());
		//updateSelectState();
		Repaint();
	}
	else if (Key == VK_F1) {
		showShellInfo();
	}
	else if (Key == VK_APPS) {
		TVirtualNode *node = GetFirstSelected();
		TRect rect = GetDisplayRect(node, 0, true, false, true);
		TPoint point = Point(rect.left, rect.top);
		point.x += rect.Width() / 2;
