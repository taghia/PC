//---------------------------------------------------------------------------
int hash(int key)
{
  int constant = 0x27d4eb2d;
  key = (key ^ 61) ^ (key >> 16);
  key = key + (key << 3);
  key = key ^ (key >> 4);
  key = key * constant;
  key = key ^ (key >> 15);
  return key;
}
//---------------------------------------------------------------------------
__int64 hashStr(String str)
{
	__int64 ret = 0;
	for (int i=0; i<str.Length(); i++) {
		ret += hash(str[i+1]);
	}
	return ret;
}
