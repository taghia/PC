//---------------------------------------------------------------------------
TModifyType TFileView::DetectModifyType(TFileObject *oldObj, TFileObject *newObj)
{
	TModifyType result = mtNone;
	if(oldObj->Size != newObj->Size) result = mtSize;
	else if(oldObj->Attribute != newObj->Attribute) result = mtAttribute;
	else if(oldObj->GetDate(dkCreated) != newObj->GetDate(dkCreated)) result = mtCreationTime;
	else if(oldObj->GetDate(dkModified) != newObj->GetDate(dkModified)) result = mtLastWriteTime;
	return result;
}
