TFileObjectArray *TFileView::GetSelectedObjects() {
	TFileObjectArray *result = new TFileObjectArray;
	TVirtualNode *node = GetFirstSelected(0);
	while (node) {
		TFileObject *obj = objectOf(node);
		if (!obj->IsDot())
		{
			result->add(obj);
		}
		 //	memcpy(result->add(), obj, sizeof(TFileObject));
		node = GetNextSelected(node, 0);
	}
	return result;
}

// ---------------------------------------------------------------------------
TNamespaceArray TFileView::CreateRootNamespaceArray(String root) {
	FreeNamespaceArray();
	m_NamespaceArray.Length = 1;
	if(root == "") root = Directory;
	m_NamespaceArray[0] = new TNamespace(root);
	return m_NamespaceArray;
}

// ---------------------------------------------------------------------------
TNamespace* TFileView::GetRootNamespace() {
	if (m_RootNamespace)
		m_RootNamespace->Free();
	m_RootNamespace = 0;
	if (FileObject && !FileObject->IsDot())
		m_RootNamespace = new TNamespace(PathFileName);
	if (!m_RootNamespace)
		m_RootNamespace = new TNamespace(Directory);
	return m_RootNamespace;
}

// ---------------------------------------------------------------------------
void TFileView::FreeNamespaceArray() {
	for (int i = 0; i < m_NamespaceArray.Length; i++)
		m_NamespaceArray[i]->Free();
	m_NamespaceArray.Length = 0;
